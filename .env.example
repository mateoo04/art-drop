# Copy to .env and adjust as needed for local development.
# .env is gitignored; .env.example is checked in.

# Postgres (matches docker-compose.yml defaults)
POSTGRES_DB=artdrop
POSTGRES_USER=artdrop
POSTGRES_PASSWORD=artdrop
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# JWT (generate with: openssl rand -base64 64 | tr -d '\n')
JWT_BASE64_SECRET=replace-me-with-a-long-random-base64-secret
