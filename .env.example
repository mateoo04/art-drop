# Copy to .env and adjust as needed for local development.
# .env is gitignored; .env.example is checked in.

# Postgres (matches docker-compose.yml defaults)
POSTGRES_DB=artdrop
POSTGRES_USER=artdrop
POSTGRES_PASSWORD=artdrop
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# JWT (generate with: openssl rand -base64 64 | tr -d '\n')
JWT_BASE64_SECRET=replace-me-with-a-long-random-base64-secret

# Public app/backend URLs for production deployments
APP_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
SPRING_PROFILES_ACTIVE=dev

# Cross-site frontend/backend deployments need Secure + SameSite=None cookies.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Optional checkout integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
